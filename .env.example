# ===================================================
# EcoCycle Environment Configuration (.env)
# ===================================================

# Server Configuration
PORT=5000

# Supabase PostgreSQL, Auth & Storage Configuration (Server-side)
# Get these from your Supabase Project: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini Vision API Key (Server-side only)
# Get from: https://aistudio.google.com
# Used by the server to inspect e-waste photos and extract diagnostic metrics
GEMINI_API_KEY=your-gemini-api-key
